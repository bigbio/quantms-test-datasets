/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running DIA-NN 2.5.0 tests (plexDIA: PXD039578)
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

/*
process {
    resourceLimits = [
       cpus: 6,
       memory: '72.GB',
       time: '48.h'
   ]
}
*/

process {
    withLabel: diann {
        container = 'docker.io/library/diann:2.5.0'
    }
}

params {
    outdir = './results_PXD039578'

    // Input data
    input = 'PXD039578_plexDIA.sdrf.tsv'
    database = 'Homo_sapiens_Swiss-Prot_0221.fasta'

    diann_version = '2.5.0'

    min_pr_mz = 450
    max_pr_mz = 1080
    min_fr_mz = 500
    max_fr_mz = 1500
    max_precursor_charge = 3
    allowed_missed_cleavages = 1
    diann_normalize = false
    max_mods = 1
    skip_post_msstats = false

    quantums = true
    diann_channel_spec_norm = true
}
