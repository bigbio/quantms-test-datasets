/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for testing DIA-NN 2.5.0 (PXD071075)
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

/*
process {
    resourceLimits = [
        cpus: 8,
        memory: '96.GB',
        time: '90.h'
    ]
}
*/

params {
    config_profile_name        = 'Test profile for DIA-NN 2.5.0'
    config_profile_description = 'Test dataset to verify pipeline compatibility with DIA-NN 2.5.0.'

    outdir = './results_PXD071075'

    // Input data
    input = 'PXD071075_sub.sdrf.tsv'
    database = 'fasta/UP000005640_9606.fasta'

    min_pr_mz = 400
    max_pr_mz = 800
    min_fr_mz = 200
    max_fr_mz = 1800
    min_peptide_length = 7
    max_peptide_length = 30
    max_precursor_charge = 4
    allowed_missed_cleavages = 2
    normalize = false
    publish_dir_mode = 'symlink'
    max_mods = 2

    diann_version = '2.5.0'
}

process {
    withLabel: diann {
        container = 'docker.io/library/diann:2.5.0'
    }
}

singularity.enabled = false
docker.enabled = true
