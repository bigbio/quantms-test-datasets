/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for testing DIA-NN 2.5.0 (MSV000088302)
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

*/

process {
    resourceLimits = [
        cpus: 16,
        memory: '96.GB',
        time: '90.h'
    ]
}

params {
    config_profile_name        = 'Test profile for DIA-NN 2.5.0'
    config_profile_description = 'Test dataset to verify pipeline compatibility with DIA-NN 2.5.0.'

    outdir = './results_MSV000088302'

    // Input data
    input = 'MSV000088302_mTRAQ3plex_local_test.sdrf.tsv'
    database = 'human_ecoli_yeast.fasta'

    min_pr_mz = 400
    max_pr_mz = 1000
    min_fr_mz = 200
    max_fr_mz = 1800
    max_precursor_charge = 4
    allowed_missed_cleavages = 2
    max_mods = 2
    skip_post_msstats = false

    quantums = true
    channel_spec_norm = true

    diann_version = '2.5.0'
}

process {
    withLabel: diann {
        container = 'docker.io/library/diann:2.5.0'
    }
    withName: 'SDRF_PARSING' {
        container = 'docker.io/library/sdrf-pipelines:local'
    }
    withName: 'GENERATE_CFG' {
        container = 'docker.io/library/quantms-utils:local'
    }
    withName: 'SAMPLESHEET_CHECK' {
        container = 'docker.io/library/quantms-utils:local'
    }
    withName: 'MZML_STATISTICS' {
        container = 'docker.io/library/quantms-utils:local'
    }
    withName: 'DIANN_MSSTATS' {
        container = 'docker.io/library/quantms-utils:local'
    }
}

singularity.enabled = false
docker.enabled = true
