/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for testing PXD071205 (DIA-NN: 2.5.0)
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

/*
process {
    resourceLimits = [
        cpus: 18,
        memory: '96.GB',
        time: '90.h'
    ]
}
*/

params {
    config_profile_name        = 'Test PXD071205'
    config_profile_description = 'Test dataset PXD071205 with DIA-NN 2.5.0.'

    outdir = './results_PXD071205'

    // Input data
    input = 'PXD071205.sdrf.tsv'
    database = 'uniprotkb_proteome_HYE_UniversalContaminants.fasta'
    min_pr_mz = 350
    max_pr_mz = 950
    min_fr_mz = 500
    max_fr_mz = 1500
    min_peptide_length = 15
    max_peptide_length = 30
    max_precursor_charge = 3
    allowed_missed_cleavages = 1
    normalize = false
    publish_dir_mode = 'symlink'
    max_mods = 2

    diann_version = '2.5.0'
}

process {
    withLabel: diann {
        container = 'docker.io/library/diann:2.5.0'
    }
}

singularity.enabled = false
docker.enabled = true
