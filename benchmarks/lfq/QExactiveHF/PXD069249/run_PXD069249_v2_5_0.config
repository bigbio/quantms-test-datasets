/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for testing DDA analysis (PXD069249, DIA-NN: 2.5.0)
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

/*
process {
    resourceLimits = [
        cpus: 16,
        memory: '96.GB',
        time: '108.h'
    ]
}
*/

params {
    config_profile_name        = 'Benchmark Test (PXD069249)'
    config_profile_description = 'DDA Test using PXD069249 with DIA-NN 2.5.0'

    outdir = './results_PXD069249'

    // Input data - PXD069249 dataset
    input = 'PXD069249.sdrf.tsv'
    database = 'uniprotkb_proteome_UP000005640_AND_revi_2026_04_21.fasta'

    // DDA mode
    dda = true
    diann_version = '2.5.0'

    // Search parameters matching PXD069249 dataset
    min_peptide_length = 7
    max_peptide_length = 30
    max_precursor_charge = 4
    allowed_missed_cleavages = 2
    normalize = false
    publish_dir_mode = 'symlink'
    max_mods = 2
}

process {
    withLabel: diann {
        container = 'docker.io/library/diann:2.5.0'
    }
}

singularity.enabled = false
docker.enabled = true
